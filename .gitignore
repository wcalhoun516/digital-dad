# Data (raw articles can be large)
data/raw/*.json
data/training/finetune.jsonl
data/training/corpus.txt
data/training/metadata.csv
data/training/instruct.jsonl
data/training/train.jsonl
data/training/heldout.jsonl

# QLoRA fine-tune run outputs (adapters, fused weights, staged mlx data) — plan 0008
data/finetune_run/

# Generated voice-eval trials (embeds real article excerpts — licensing; example is committed)
eval/voice_trials*.json
!eval/voice_trials.example.json

# Hand-picked voice exemplars for the in-context arms — 50 passages, ~18k words of his
# actual prose. Same licensing rule as the trials (D7). Regenerate locally; the
# selection is reproducible from the recorded record_index + sha1 in the file.
eval/voice_exemplars.json

# Voice-eval raw reports — the JSON carries the prompts (which quote article
# fragments). The rendered .md reports are tables only and ARE committed: they
# are the finding, and they are what a future run compares against.
data/analysis/voice_eval*
!data/analysis/voice_eval*.md
# ...and the run history IS the deliverable (#60): scores + corpus size, zero prose
# (longest string in it is a model id). It must persist in git to be a time series.
!data/analysis/voice_eval_history.jsonl

# Geo-LLM fine-tune registration marker (plan 0008 26e) — owner-produced, local;
# mirrors what's registered in the sibling conductor's models.yaml.
data/analysis/geo_llm_registration.json

# Geo-LLM status snapshot — its `sample_pair` embeds a full article body
# (~10k chars), so it falls under the same licensing rule as reading_room /
# calhoun_isms / anthology. Regenerate locally; never commit.
data/analysis/geo_llm.json

# Embeddings index — regenerated by `make analyze`
data/analysis/embeddings.npy
data/analysis/embeddings_meta.json
data/analysis/embeddings.json

# Reading Room (roadmap #21) — embeds full article bodies, so regenerate on demand with
# `make reading-room`; never committed (licensing), CI inlines an empty stub instead.
data/analysis/reading_room.json

# Calhoun-isms (roadmap #16) — embeds sentence excerpts of article bodies, so regenerate on
# demand with `make calhoun-isms`; never committed (licensing), same posture as reading_room.
data/analysis/calhoun_isms.json

# Contradiction / mind-change finder (roadmap #15) — embeds sentence excerpts of article
# bodies, so regenerate on demand with `make contradictions`; never committed (licensing).
data/analysis/contradictions.json

# Anthology keepsake (roadmap #24) — `make anthology` build outputs (structured JSON, the
# print-ready HTML, and its PDF), regenerate on demand; never committed.
data/analysis/anthology.json
data/analysis/anthology.html
data/analysis/anthology.pdf

# Weekly cron logs (the directory is kept via .gitkeep)
data/cron/*.log
data/cron/*.out
data/cron/*.err
data/cron/*.jsonl

# Daily product-dev agent logs
logs/

# On This Day recipient list (personal addresses; example is committed)
data/cron/recipients.txt

# Rendered weekly emails — each pastes the matched article in full (~900 words),
# so these are redistribution of Forbes text under D7. Regenerate with
# `make on-this-day`; on_this_day.run() mkdirs the directory itself.
data/cron/emails/

# Claude Code local config (launch.json is shared; these are machine-local)
.claude/settings.local.json
.claude/worktrees/

# Generated dashboard
dashboard/index.html

# Browser state from Playwright
data/.browser-state/

# Environment
.env

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv/

# OS
.DS_Store
Thumbs.db

# Corpus II ingest (#30). Dropped originals and staged extractions are private family
# material — never committed. Only the reviewed manifest entry lands in git.
data/inbox/
data/ingest/

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.calhoun.digitaldad-weekly</string>

    <!-- ProgramArguments points at the trampoline STAGED ON THE SYSTEM DISK so
         the job can launch before the external volume mounts. The installer
         substitutes __TRAMPOLINE_PATH__ with the real staged path. The
         trampoline waits for the volume, then runs bin/weekly_run.sh. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__TRAMPOLINE_PATH__</string>
    </array>

    <!-- Sunday at 03:00 local time. macOS launchd runs missed jobs on next
         wake, so this is robust to the Mac mini being asleep at 3am. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>KeepAlive</key>
    <false/>

    <!-- Logs stay on /tmp (system disk), NEVER the external volume. A volume
         path here makes launchd recreate /Volumes/FamilyWorkDrive as a squatter
         dir when the job fires unmounted, renaming the real mount. The real
         run log still lands in data/cron/weekly.log via weekly_run.sh. -->
    <key>StandardOutPath</key>
    <string>/tmp/digitaldad_weekly.out.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/digitaldad_weekly.err.log</string>
</dict>
</plist>
